# Environment variables and secrets
.env
.env.*
!.env.example
echo .env>>.gitignore
echo .venv/>>.gitignore
echo venv/>>.gitignore
echo __pycache__/>>.gitignore

# Python virtual environments
.venv/
venv/
env/
ENV/

# Python cache / compiled files
__pycache__/
*.py[cod]
*$py.class

# Testing / coverage
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/

# Logs
*.log
logs/
backend/logs/

# IDE / editor files
.vscode/
.idea/
*.code-workspace

# OS files
.DS_Store
Thumbs.db
desktop.ini

# Build / distribution
build/
dist/
*.egg-info/

# Temporary files
*.tmp
*.temp
*.bak

# Node/frontend dependencies
node_modules/

# Local secrets / certificates
*.pem
*.key
*.p12
*.pfx

# Local database/runtime files
*.sqlite
*.sqlite3
*.db

# Keep the packaged Chroma database used by the application
!db/
!db/**
!backend/db/
!backend/db/**