# Copy this file to .env and fill in real values. Never commit .env.

AZURE_OPENAI_ENDPOINT=https://your-resource-name.openai.azure.com/
AZURE_OPENAI_API_KEY=your-azure-openai-key
AZURE_OPENAI_API_VERSION=2024-06-01

# Must match the embedding deployment used in Phase 1
AZURE_EMBEDDING_DEPLOYMENT=text-embedding-3-small

# Chat model deployment (gpt-4.1-mini or whatever you deployed)
AZURE_CHAT_DEPLOYMENT=gpt-4.1-mini

# Must match Phase 1's settings so we open the same DB/collection
CHROMA_PATH=db
CHROMA_COLLECTION_NAME=rate_card

TOP_K=5
TEMPERATURE=0
MAX_TOKENS=800

# GPT-5 / o-series models require max_completion_tokens and generally only
# support default temperature. Leave both "true" for GPT-5. Set to "false"
# if you switch to gpt-4.1-mini or another model that uses the classic
# max_tokens/temperature params.
USE_MAX_COMPLETION_TOKENS=true
FIX_TEMPERATURE=true

LOG_PATH=logs/phase2.log
QUERY_LOG_PATH=logs/queries.jsonl
